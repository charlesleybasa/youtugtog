# Copy to `.env.capacitor`. Loaded only by `npm run build:capacitor`
# (Vite's `--mode capacitor`), layered on top of `.env`.
#
# The Android bundle has no server behind its https://localhost origin, so
# /api/* calls must be pointed at the deployed functions. This value is
# inlined into the JS at build time — it is a public URL, not a secret, but
# it does mean you must rebuild + `npx cap sync` to change it.
VITE_API_BASE_URL=https://youtugtog.vercel.app
