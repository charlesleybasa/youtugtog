# Copy this file to .env and add your own key.

# --- Server-side (Vercel serverless functions) -------------------------
# Never prefixed with VITE_: that would inline the secret into the client
# bundle, and in an Android build the bundle ships inside the APK where
# anyone can unzip and read it.
YOUTUBE_API_KEY=YOUR_KEY_HERE

# Extra browser origins allowed to call /api/*, comma-separated. The
# Capacitor origins (https://localhost, capacitor://localhost) are already
# allowed in api/_cors.ts; add preview or custom domains here.
# ALLOWED_ORIGINS=https://staging.example.com

# --- Client-side (inlined into the bundle at build time) ---------------
# Absolute origin hosting the /api/* functions. Leave UNSET for web builds
# so API calls stay same-origin. REQUIRED for Capacitor/Android builds,
# where the WebView origin is https://localhost and has no server behind it.
# See .env.capacitor.example.
# VITE_API_BASE_URL=https://youtugtog.vercel.app
