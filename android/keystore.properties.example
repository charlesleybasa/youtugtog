# Copy to `keystore.properties` (same directory) and fill in.
#
# That file is gitignored and must stay that way: together with the .jks it
# points at, it is what proves to Google Play that an update came from you.
#
# storeFile is resolved relative to the `android/` directory.
#
# Generate the keystore with:
#
#   keytool -genkeypair -v \
#     -keystore android/upload-keystore.jks \
#     -alias upload \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# Back up upload-keystore.jks somewhere durable. If you enrol in Play App
# Signing (the default for new apps) Google can reset a lost upload key, but
# losing the key without that enrolment means you can never update the app —
# only publish a new listing under a different applicationId.

storeFile=upload-keystore.jks
storePassword=
keyAlias=upload
keyPassword=
