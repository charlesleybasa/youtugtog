<?xml version="1.0" encoding="utf-8"?>
<!--
  Overrides the identically-named layout inside the Capacitor library so the
  bridge inflates BackgroundAudioWebView instead of CapacitorWebView. Resources
  in the app module win over library resources of the same name, and
  Bridge.Builder looks the view up by @id/webview and only requires that it be a
  WebView, so the swap is invisible to Capacitor.

  Keep @id/webview and the CoordinatorLayout root: Bridge does findViewById on
  that id, and losing it falls back to the "no webview" error screen.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.getcapacitor.BridgeActivity"
    >

    <com.youtugtog.app.BackgroundAudioWebView
        android:id="@+id/webview"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
